#!/usr/bin/env python3
"""Print one status line per effort the dashboard app shows, from dashboard.model.load_snapshot.

Takes a directory argument, or Claude Code status JSON on stdin
(workspace.current_dir, else cwd). Prints nothing when the directory has
no store, the CLI fails, or the snapshot takes longer than TIMEOUT seconds.

With --tmux, prints a single ``⚑ <n>`` for the merged Needs you count
(including Merge branch items), or nothing when the count is zero.
"""

from __future__ import annotations

import json
import os
import signal
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
from dashboard.artifact_store import resolve  # noqa: E402
from dashboard.gates import apply_landing_needs, landings_for_snapshot  # noqa: E402
from dashboard.model import ModelError, Snapshot, load_snapshot  # noqa: E402

TIMEOUT = 2


def target_directory(argv: list[str]) -> Path | None:
    if argv:
        return Path(argv[0])
    raw = "" if sys.stdin.isatty() else sys.stdin.read()
    if not raw.strip():
        return Path.cwd()
    try:
        status = json.loads(raw)
    except ValueError:
        return None
    if not isinstance(status, dict):
        return None
    workspace = status.get("workspace")
    directory = (workspace.get("current_dir") if isinstance(workspace, dict) else None) or status.get("cwd")
    return Path(directory) if isinstance(directory, str) and directory else None


def summarize(snapshot: Snapshot) -> list[str]:
    lines = []
    for view in snapshot.efforts:
        counts = {
            "running": sum(task.status == "running" for task in view.tasks),
            "ready": sum(task.status == "ready" for task in view.tasks),
            "needs you": len(view.needs_you),
        }
        lines.append(" · ".join([view.effort, *(f"{count} {key}" for key, count in counts.items() if count)]))
    return lines


def summarize_tmux(root: Path, snapshot: Snapshot) -> str | None:
    landings = landings_for_snapshot(root, snapshot)
    merged = apply_landing_needs(snapshot, landings)
    count = sum(len(view.needs_you) for view in merged.efforts)
    if count == 0:
        return None
    return f"⚑ {count}"


def _give_up(signum, frame) -> None:
    os._exit(0)


def main(argv: list[str]) -> int:
    tmux = False
    rest: list[str] = []
    for arg in argv:
        if arg == "--tmux":
            tmux = True
        else:
            rest.append(arg)
    directory = target_directory(rest)
    if directory is None or not directory.is_dir():
        return 0
    target = resolve(directory)
    if target.store is None or target.contract is None:
        return 0
    signal.signal(signal.SIGALRM, _give_up)
    signal.alarm(TIMEOUT)
    try:
        snapshot = load_snapshot(target)
        if tmux:
            line = summarize_tmux(target.root, snapshot)
            if line:
                print(line)
            return 0
        for line in summarize(snapshot):
            print(line)
    except (ModelError, OSError):
        return 0
    finally:
        signal.alarm(0)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
