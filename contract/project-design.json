{
  "format": "adaptive-artifacts/project-design@0.3.0",
  "project": "se-workflow",
  "kind": "software_engineering",
  "assessment": {
    "discontinuity": "high",
    "external_investigation": "low",
    "decision_density": "medium",
    "orientation_cost": "medium",
    "operational_risk": "low",
    "concurrency": "high",
    "verification_cost": "high"
  },
  "records": [
    {
      "name": "active-goal",
      "pattern": "current-status",
      "purpose": "Live outcome of this effort",
      "canonical_for": "the live goal of this subject",
      "capture": "at_event",
      "read": "always",
      "payload": [
        "goal",
        "scope",
        "kind",
        "status",
        "merged_from",
        "depth"
      ],
      "optional_payload": [
        "status",
        "merged_from",
        "depth"
      ],
      "payload_enum": {
        "status": [
          "open",
          "closed"
        ],
        "depth": [
          "trivial",
          "standard",
          "full"
        ]
      }
    },
    {
      "name": "current-position",
      "pattern": "current-status",
      "purpose": "Live position: current phase and what is in flight",
      "canonical_for": "the live position of this subject",
      "capture": "at_event",
      "read": "always",
      "payload": [
        "position",
        "scope",
        "effort",
        "phase",
        "status",
        "stage"
      ],
      "optional_payload": [
        "phase",
        "status",
        "stage"
      ],
      "payload_references": {
        "phase": "project:phase"
      },
      "payload_enum": {
        "status": [
          "open",
          "closed"
        ],
        "stage": [
          "intent",
          "specify",
          "design",
          "plan",
          "execute",
          "integrate",
          "verify",
          "diagnose",
          "repair",
          "release",
          "deploy",
          "monitor",
          "feedback"
        ]
      }
    },
    {
      "name": "phase",
      "pattern": "phase",
      "purpose": "The plan for one phase of the project: problem, approach, and exit criteria",
      "canonical_for": "the plan for this phase",
      "capture": "explicit",
      "read": "if_relevant",
      "payload": [
        "title",
        "ordinal",
        "effort"
      ],
      "required_sections": [
        "Problem",
        "Approach",
        "Exit criteria"
      ]
    },
    {
      "name": "work-item",
      "pattern": "task",
      "purpose": "A unit of work with a staged lifecycle and dependencies on other work",
      "canonical_for": "the work item for this subject",
      "capture": "at_event",
      "read": "if_relevant",
      "payload": [
        "title",
        "phase",
        "kind",
        "assignee",
        "effort",
        "executor",
        "satisfies",
        "design"
      ],
      "optional_payload": [
        "executor",
        "satisfies",
        "design"
      ],
      "required_sections": [
        "Description"
      ],
      "payload_references": {
        "phase": "project:phase",
        "design": "project:design"
      },
      "payload_enum": {
        "executor": [
          "inline",
          "subagent"
        ]
      }
    },
    {
      "name": "acceptance",
      "pattern": "definition",
      "purpose": "What done means for this change",
      "canonical_for": "what done means for this change",
      "capture": "explicit",
      "read": "if_relevant",
      "payload": [
        "criterion",
        "method",
        "phase",
        "effort",
        "verify_command",
        "specification"
      ],
      "payload_references": {
        "phase": "project:phase",
        "specification": "project:specification"
      },
      "optional_payload": [
        "specification"
      ]
    },
    {
      "name": "constraint",
      "pattern": "definition",
      "purpose": "A confirmed constraint that is not a choice and has no alternatives",
      "canonical_for": "the confirmed constraint for this subject",
      "capture": "at_event",
      "read": "if_relevant",
      "payload": [
        "statement",
        "applies_to",
        "effort"
      ],
      "required_sections": [
        "Basis"
      ]
    },
    {
      "name": "check-run",
      "pattern": "event",
      "purpose": "That this criterion was tested at a revision",
      "canonical_for": "that this criterion was tested at this revision",
      "capture": "at_event",
      "read": "query",
      "payload": [
        "criterion_id",
        "revision",
        "result",
        "effort",
        "method",
        "signed_by",
        "verdict",
        "layer",
        "uncertainty"
      ],
      "optional_payload": [
        "verdict",
        "layer",
        "uncertainty"
      ],
      "payload_enum": {
        "verdict": [
          "pass",
          "fail",
          "blocked",
          "unknown"
        ],
        "layer": [
          "build",
          "unit",
          "integration",
          "acceptance",
          "static",
          "types",
          "security",
          "regression",
          "design",
          "behavior"
        ]
      }
    },
    {
      "name": "decision",
      "pattern": "decision",
      "purpose": "An adopted choice among alternatives",
      "canonical_for": "the adopted choice for this question",
      "capture": "at_event",
      "read": "if_relevant",
      "payload": [
        "choice",
        "alternatives",
        "phase",
        "effort",
        "serves"
      ],
      "required_sections": [
        "Rationale",
        "Counter-argument"
      ],
      "payload_references": {
        "phase": "project:phase"
      },
      "optional_payload": [
        "serves"
      ]
    },
    {
      "name": "continuity-question",
      "pattern": "question",
      "purpose": "A blocker that stops dispatch or resume",
      "canonical_for": "whether this unknown blocks continuity",
      "capture": "at_event",
      "read": "always",
      "payload": [
        "owner",
        "blocking",
        "scope"
      ]
    },
    {
      "name": "failed-attempt",
      "pattern": "event",
      "purpose": "An approach that should not be retried as-is",
      "canonical_for": "that this approach was abandoned",
      "capture": "at_event",
      "read": "if_relevant",
      "payload": [
        "attempted_action",
        "retry_when",
        "effort"
      ]
    },
    {
      "name": "investigation-observation",
      "pattern": "observation",
      "purpose": "What was observed while diagnosing or evaluating",
      "canonical_for": "what was observed in this investigation",
      "capture": "at_event",
      "read": "query",
      "payload": [
        "source",
        "observed_time",
        "environment",
        "what_was_observed",
        "effort"
      ]
    },
    {
      "name": "finding",
      "pattern": "finding",
      "purpose": "Root cause or comparative evaluation conclusion",
      "canonical_for": "the investigation conclusion for this claim",
      "capture": "at_event",
      "read": "if_relevant",
      "payload": [
        "claim",
        "basis",
        "invalidated_when",
        "effort",
        "needs"
      ],
      "required_sections": [
        "Evidence",
        "Consequence",
        "Follow-up"
      ]
    },
    {
      "name": "assignment",
      "pattern": "instruction",
      "purpose": "What the orchestrator handed an executor for a work-item",
      "canonical_for": "the dispatch of this work-item to this executor",
      "capture": "at_event",
      "read": "if_relevant",
      "payload": [
        "work_item",
        "executor",
        "effort"
      ],
      "required_sections": [
        "Orientation"
      ],
      "payload_references": {
        "work_item": "project:work-item"
      }
    },
    {
      "name": "assignment-amendment",
      "pattern": "instruction",
      "purpose": "A mid-flight correction to an assignment already in progress",
      "canonical_for": "the correction issued to this assignment",
      "capture": "at_event",
      "read": "if_relevant",
      "payload": [
        "assignment",
        "effort"
      ],
      "required_sections": [
        "Correction"
      ],
      "payload_references": {
        "assignment": "project:assignment"
      }
    },
    {
      "name": "execution-report",
      "pattern": "observation",
      "purpose": "What an executor returned for its assignment, body verbatim",
      "canonical_for": "what this executor returned for this assignment",
      "capture": "at_event",
      "read": "query",
      "payload": [
        "work_item",
        "assignment",
        "result",
        "verdict",
        "revision"
      ],
      "payload_references": {
        "work_item": "project:work-item",
        "assignment": "project:assignment"
      }
    },
    {
      "name": "specification",
      "pattern": "definition",
      "purpose": "Required behavior, constraints, success, and out-of-scope bounds for a phase",
      "canonical_for": "the specification for this phase",
      "capture": "explicit",
      "read": "if_relevant",
      "payload": [
        "summary",
        "weight",
        "phase",
        "effort"
      ],
      "payload_enum": {
        "weight": [
          "light",
          "full"
        ]
      },
      "payload_references": {
        "phase": "project:phase"
      },
      "required_sections": [
        "Problem",
        "Required behavior",
        "Constraints",
        "Success",
        "Out of scope"
      ]
    },
    {
      "name": "design",
      "pattern": "definition",
      "purpose": "Architectural approach for a phase, separate from the implementation plan",
      "canonical_for": "the design for this phase",
      "capture": "explicit",
      "read": "if_relevant",
      "payload": [
        "summary",
        "weight",
        "phase",
        "effort",
        "specification"
      ],
      "optional_payload": [
        "specification"
      ],
      "payload_enum": {
        "weight": [
          "light",
          "full",
          "skipped"
        ]
      },
      "payload_references": {
        "phase": "project:phase",
        "specification": "project:specification"
      },
      "required_sections": [
        "Approach",
        "Decisions",
        "Interfaces",
        "Invariants",
        "Alternatives",
        "Risks",
        "Consequences"
      ]
    },
    {
      "name": "integration-report",
      "pattern": "observation",
      "purpose": "Semantic integration checkpoint after parallel or cross-cutting execution",
      "canonical_for": "the integration verdict for this phase revision",
      "capture": "at_event",
      "read": "query",
      "payload": [
        "phase",
        "effort",
        "verdict",
        "revision",
        "summary"
      ],
      "payload_enum": {
        "verdict": [
          "pass",
          "fail",
          "blocked",
          "unknown"
        ]
      },
      "payload_references": {
        "phase": "project:phase"
      },
      "required_sections": [
        "Merged work",
        "Conflicts",
        "Invariants",
        "Assumptions"
      ]
    },
    {
      "name": "uncertainty",
      "pattern": "current-status",
      "purpose": "An open gap between recorded checks and the specification. Accept or resolve it by supersede.",
      "canonical_for": "this unresolved uncertainty",
      "capture": "at_event",
      "read": "if_relevant",
      "payload": [
        "statement",
        "effort",
        "status",
        "criterion_id"
      ],
      "optional_payload": [
        "criterion_id"
      ],
      "payload_enum": {
        "status": [
          "open",
          "accepted",
          "resolved"
        ]
      },
      "required_sections": [
        "Evidence"
      ]
    },
    {
      "name": "repair-attempt",
      "pattern": "event",
      "purpose": "One completed diagnose-repair cycle and why it stopped or what it changed",
      "canonical_for": "this repair attempt for this work item",
      "capture": "at_event",
      "read": "query",
      "payload": [
        "work_item",
        "effort",
        "attempt",
        "failure_signature",
        "outcome",
        "diagnosis",
        "finding"
      ],
      "optional_payload": [
        "diagnosis",
        "finding"
      ],
      "payload_enum": {
        "outcome": [
          "repaired",
          "failed_again",
          "unresolved",
          "escalated"
        ]
      },
      "payload_references": {
        "work_item": "project:work-item",
        "finding": "project:finding"
      }
    },
    {
      "name": "release",
      "pattern": "current-status",
      "purpose": "Release posture of a verified phase. Verified is not deployed.",
      "canonical_for": "the release posture of this phase",
      "capture": "at_event",
      "read": "if_relevant",
      "payload": [
        "phase",
        "effort",
        "status",
        "note"
      ],
      "payload_enum": {
        "status": [
          "ready_to_merge",
          "merged",
          "artifact_produced",
          "deployment_initiated",
          "deployment_succeeded",
          "deployment_failed"
        ]
      },
      "payload_references": {
        "phase": "project:phase"
      }
    },
    {
      "name": "feedback",
      "pattern": "observation",
      "purpose": "A runtime or user signal that can become new work at intent",
      "canonical_for": "this feedback signal",
      "capture": "at_event",
      "read": "if_relevant",
      "payload": [
        "source",
        "kind",
        "summary",
        "effort"
      ],
      "optional_payload": [
        "effort"
      ],
      "payload_enum": {
        "kind": [
          "error",
          "performance",
          "security",
          "user_report",
          "anomaly",
          "edge_case"
        ]
      },
      "required_sections": [
        "Signal",
        "Suggested intake"
      ]
    }
  ],
  "views": [
    {
      "name": "handoff",
      "owns_facts": false,
      "freshness": "on_demand_or_handoff",
      "parameters": [
        "group_by"
      ],
      "roles": [
        {
          "name": "goal",
          "occupant": "active-goal",
          "requires_payload": [
            "goal",
            "scope",
            "kind"
          ],
          "selection": {
            "all": [
              {
                "field": "lifecycle_state",
                "equals": "active"
              },
              {
                "field": "payload.status",
                "not_equals": "closed"
              }
            ]
          }
        },
        {
          "name": "position",
          "occupant": "current-position",
          "requires_payload": [
            "position",
            "scope"
          ],
          "selection": {
            "all": [
              {
                "field": "lifecycle_state",
                "equals": "active"
              },
              {
                "field": "payload.status",
                "not_equals": "closed"
              }
            ]
          }
        },
        {
          "name": "in-progress",
          "occupant": "work-item",
          "requires_payload": [
            "title",
            "phase",
            "kind",
            "effort"
          ],
          "selection": {
            "all": [
              {
                "field": "lifecycle_state",
                "equals": "in_progress"
              }
            ]
          }
        },
        {
          "name": "blocking-question",
          "occupant": "continuity-question",
          "requires_payload": [
            "blocking",
            "scope"
          ],
          "selection": {
            "all": [
              {
                "field": "lifecycle_state",
                "equals": "open"
              },
              {
                "field": "payload.blocking",
                "equals": true
              }
            ]
          }
        },
        {
          "name": "needs-human",
          "occupant": "finding",
          "requires_payload": [
            "claim",
            "needs"
          ],
          "selection": {
            "all": [
              {
                "field": "payload.needs",
                "equals": "human"
              },
              {
                "field": "lifecycle_state",
                "any_of": [
                  "asserted",
                  "supported",
                  "disputed"
                ]
              }
            ]
          }
        },
        {
          "name": "unsigned-manual-check",
          "occupant": "check-run",
          "requires_payload": [
            "criterion_id",
            "result",
            "method",
            "signed_by"
          ],
          "selection": {
            "all": [
              {
                "field": "payload.method",
                "equals": "manual"
              },
              {
                "field": "payload.signed_by",
                "equals": ""
              },
              {
                "field": "derived.corrected",
                "not_equals": true
              }
            ]
          }
        },
        {
          "name": "open-uncertainty",
          "occupant": "uncertainty",
          "requires_payload": [
            "statement",
            "status",
            "effort"
          ],
          "selection": {
            "all": [
              {
                "field": "lifecycle_state",
                "equals": "active"
              },
              {
                "field": "payload.status",
                "equals": "open"
              }
            ]
          }
        }
      ]
    },
