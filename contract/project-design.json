  "backend": "git-filesystem",
  "view_params": {
    "project:handoff": {
      "group_by": "subject"
    },
    "project:plan": {
      "group_by": "phase",
      "order_by": "ordinal"
    },
    "project:verification": {
      "group_by": "subject"
    },
    "project:status": {
      "group_by": "phase",
      "order_by": "ordinal",
      "show_lifecycle_state": true,
      "show_derived": [
        "ready",
        "wave"
      ],
      "tally_source_type": "project:check-run",
      "tally_result_field": "result"
    },
    "project:brief": {
