            "verify_command"
          ],
          "selection": {
            "all": [
              {
                "field": "lifecycle_state",
                "equals": "active"
              }
            ]
          }
        },
        {
          "name": "check",
          "occupant": "check-run",
          "requires_payload": [
            "criterion_id",
            "revision",
            "result",
            "method",
            "signed_by"
          ],
          "selection": {
            "all": []
