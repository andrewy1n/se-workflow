{
  "format": "adaptive-artifacts/project-design@0.3.0",
  "project": "se-workflow",
  "kind": "software_engineering",
  "assessment": {
    "discontinuity": "high",
    "external_investigation": "low",
    "decision_density": "medium",
    "orientation_cost": "medium",
    "operational_risk": "low",
    "concurrency": "high",
    "verification_cost": "high"
  },
  "records": [
    {
      "name": "active-goal",
      "pattern": "current-status",
      "purpose": "Live outcome of this effort",
      "canonical_for": "the live goal of this subject",
      "capture": "at_event",
      "read": "always",
      "payload": [
        "goal",
        "scope",
        "kind"
      ]
    },
    {
      "name": "current-position",
      "pattern": "current-status",
      "purpose": "Live position: current phase and what is in flight",
      "canonical_for": "the live position of this subject",
      "capture": "at_event",
      "read": "always",
      "payload": [
        "position",
        "scope",
        "effort",
        "phase"
      ],
      "optional_payload": [
        "phase"
      ],
      "payload_references": {
        "phase": "project:phase"
      }
    },
    {
      "name": "phase",
      "pattern": "phase",
      "purpose": "The plan for one phase of the project: problem, approach, and exit criteria",
      "canonical_for": "the plan for this phase",
      "capture": "explicit",
      "read": "if_relevant",
      "payload": [
        "title",
        "ordinal",
        "effort"
      ],
      "required_sections": [
        "Problem",
        "Approach",
        "Exit criteria"
      ]
    },
    {
      "name": "work-item",
      "pattern": "task",
      "purpose": "A unit of work with a staged lifecycle and dependencies on other work",
      "canonical_for": "the work item for this subject",
      "capture": "at_event",
      "read": "if_relevant",
      "payload": [
        "title",
        "phase",
        "kind",
        "assignee",
        "effort"
      ],
      "required_sections": [
        "Description"
      ],
      "payload_references": {
        "phase": "project:phase"
      }
    },
    {
      "name": "acceptance",
      "pattern": "definition",
      "purpose": "What done means for this change",
      "canonical_for": "what done means for this change",
      "capture": "explicit",
      "read": "if_relevant",
      "payload": [
        "criterion",
        "method",
        "phase",
        "effort",
        "verify_command"
      ],
      "payload_references": {
        "phase": "project:phase"
      }
    },
    {
      "name": "constraint",
      "pattern": "definition",
      "purpose": "A confirmed constraint that is not a choice and has no alternatives",
      "canonical_for": "the confirmed constraint for this subject",
      "capture": "at_event",
      "read": "if_relevant",
      "payload": [
        "statement",
        "applies_to",
        "effort"
      ],
      "required_sections": [
        "Basis"
      ]
    },
    {
      "name": "check-run",
      "pattern": "event",
      "purpose": "That this criterion was tested at a revision",
      "canonical_for": "that this criterion was tested at this revision",
      "capture": "at_event",
      "read": "query",
      "payload": [
        "criterion_id",
        "revision",
        "result",
        "effort",
        "method",
        "signed_by"
      ]
    },
    {
      "name": "decision",
      "pattern": "decision",
      "purpose": "An adopted choice among alternatives",
      "canonical_for": "the adopted choice for this question",
      "capture": "at_event",
      "read": "if_relevant",
      "payload": [
        "choice",
        "alternatives",
        "phase",
        "effort"
      ],
      "required_sections": [
        "Rationale",
        "Counter-argument"
      ],
      "payload_references": {
        "phase": "project:phase"
      }
    },
    {
      "name": "continuity-question",
      "pattern": "question",
      "purpose": "A blocker that stops dispatch or resume",
      "canonical_for": "whether this unknown blocks continuity",
      "capture": "at_event",
      "read": "always",
      "payload": [
        "owner",
        "blocking",
        "scope"
      ]
    },
    {
      "name": "failed-attempt",
      "pattern": "event",
      "purpose": "An approach that should not be retried as-is",
      "canonical_for": "that this approach was abandoned",
      "capture": "at_event",
      "read": "if_relevant",
      "payload": [
        "attempted_action",
        "retry_when",
        "effort"
      ]
    },
    {
      "name": "investigation-observation",
      "pattern": "observation",
      "purpose": "What was observed while diagnosing or evaluating",
      "canonical_for": "what was observed in this investigation",
      "capture": "at_event",
      "read": "query",
      "payload": [
        "source",
        "observed_time",
        "environment",
        "what_was_observed",
        "effort"
      ]
    },
    {
      "name": "finding",
      "pattern": "finding",
      "purpose": "Root cause or comparative evaluation conclusion",
      "canonical_for": "the investigation conclusion for this claim",
      "capture": "at_event",
      "read": "if_relevant",
      "payload": [
        "claim",
        "basis",
        "invalidated_when",
        "effort",
        "needs"
      ],
      "required_sections": [
        "Evidence",
        "Consequence",
        "Follow-up"
      ]
    },
    {
      "name": "assignment",
      "pattern": "instruction",
      "purpose": "What the orchestrator handed an executor for a work-item",
      "canonical_for": "the dispatch of this work-item to this executor",
      "capture": "at_event",
      "read": "if_relevant",
      "payload": [
        "work_item",
        "executor",
        "effort"
      ],
      "required_sections": [
        "Orientation"
      ],
      "payload_references": {
        "work_item": "project:work-item"
      }
    },
    {
      "name": "assignment-amendment",
      "pattern": "instruction",
      "purpose": "A mid-flight correction to an assignment already in progress",
      "canonical_for": "the correction issued to this assignment",
      "capture": "at_event",
      "read": "if_relevant",
      "payload": [
        "assignment",
        "effort"
      ],
      "required_sections": [
        "Correction"
      ],
      "payload_references": {
        "assignment": "project:assignment"
      }
    },
    {
      "name": "execution-report",
      "pattern": "observation",
      "purpose": "What an executor returned for its assignment, body verbatim",
      "canonical_for": "what this executor returned for this assignment",
      "capture": "at_event",
      "read": "query",
      "payload": [
        "work_item",
        "assignment",
        "result",
        "verdict",
        "revision"
      ],
      "payload_references": {
        "work_item": "project:work-item",
        "assignment": "project:assignment"
      }
    }
  ],
  "views": [
    {
      "name": "handoff",
      "owns_facts": false,
      "freshness": "on_demand_or_handoff",
      "parameters": [
        "group_by"
      ],
      "roles": [
        {
          "name": "goal",
          "occupant": "active-goal",
          "requires_payload": [
            "goal",
            "scope",
            "kind"
          ],
          "selection": {
            "all": [
              {
                "field": "lifecycle_state",
                "equals": "active"
              }
            ]
          }
        },
        {
          "name": "position",
          "occupant": "current-position",
          "requires_payload": [
            "position",
            "scope"
          ],
          "selection": {
            "all": [
              {
                "field": "lifecycle_state",
                "equals": "active"
              }
            ]
          }
        },
        {
          "name": "in-progress",
          "occupant": "work-item",
          "requires_payload": [
            "title",
            "phase",
            "kind",
            "effort"
          ],
          "selection": {
            "all": [
              {
                "field": "lifecycle_state",
                "equals": "in_progress"
              }
            ]
          }
        },
        {
          "name": "blocking-question",
          "occupant": "continuity-question",
          "requires_payload": [
            "blocking",
            "scope"
          ],
          "selection": {
            "all": [
              {
                "field": "lifecycle_state",
                "equals": "open"
              },
              {
                "field": "payload.blocking",
                "equals": true
              }
            ]
          }
        },
        {
          "name": "needs-human",
          "occupant": "finding",
          "requires_payload": [
            "claim",
            "needs"
          ],
          "selection": {
            "all": [
              {
                "field": "payload.needs",
                "equals": "human"
              }
            ]
          }
        },
        {
          "name": "unsigned-manual-check",
          "occupant": "check-run",
          "requires_payload": [
            "criterion_id",
            "result",
            "method",
            "signed_by"
          ],
          "selection": {
            "all": [
              {
                "field": "payload.method",
                "equals": "manual"
              },
              {
                "field": "payload.signed_by",
                "equals": ""
              }
            ]
          }
        }
      ]
    },
    {
      "name": "plan",
      "owns_facts": false,
      "freshness": "on_demand",
      "parameters": [
        "group_by",
        "order_by"
      ],
      "roles": [
        {
          "name": "phase",
          "occupant": "phase",
          "requires_payload": [
            "title",
            "ordinal",
            "effort"
          ],
          "selection": {
            "all": [
              {
                "field": "lifecycle_state",
                "any_of": [
                  "planned",
                  "in_progress"
                ]
              }
            ]
          }
        },
        {
          "name": "work",
          "occupant": "work-item",
          "requires_payload": [
            "title",
            "phase",
            "kind",
            "effort"
          ],
          "selection": {
            "all": [
              {
                "field": "lifecycle_state",
                "any_of": [
                  "planned",
                  "in_progress"
                ]
              }
            ]
          }
        },
        {
          "name": "acceptance",
          "occupant": "acceptance",
          "requires_payload": [
            "criterion",
