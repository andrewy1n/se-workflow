#!/usr/bin/env python3
"""Run the Textual dashboard (dashboard_app.py, through uv) for the current directory's repo.

Extra arguments go to the app, e.g. `dashboard --once` or `dashboard --interval 5`.
"""

from __future__ import annotations

import os
import shutil
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from artifact_store import resolve  # noqa: E402

APP = Path(__file__).resolve().parent / "dashboard_app.py"


def wait_for_key() -> None:
    if not sys.stdin.isatty():
        return
    import termios
    import tty

    print("\nPress any key to close.", flush=True)
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        os.read(fd, 1)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)


def fail(message: str) -> int:
    print(message, flush=True)
    wait_for_key()
    return 1


def find_uv() -> str | None:
    override = os.environ.get("SE_WORKFLOW_UV")
    if override:
        return override
    local = Path.home() / ".local" / "bin" / "uv"
    return shutil.which("uv") or (str(local) if os.access(local, os.X_OK) else None)


def main(argv: list[str]) -> int:
    target = resolve(Path.cwd())
    if target.store is None:
        return fail(
            f"No artifact store for {target.root}.\n"
            f"Looked for meta.json in:\n  {target.home_store()}\n  {target.repo_store()}"
        )
    uv = find_uv()
    if uv is None:
        return fail(
            "Cannot find uv, which runs the dashboard.\n"
            "Install it: https://docs.astral.sh/uv/getting-started/installation/\n"
            "Or set SE_WORKFLOW_UV to its path."
        )
    command = [uv, "run", "--script", str(APP), *argv]
    try:
        os.chdir(target.root)
        os.execv(command[0], command)
    except OSError as exc:
        return fail(f"Cannot run {command[0]}: {exc}")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
