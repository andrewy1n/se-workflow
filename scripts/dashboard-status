#!/usr/bin/env python3
"""Print one status line per live effort in the project:dashboard view.

Takes a directory argument, or Claude Code status JSON on stdin
(workspace.current_dir, else cwd). Prints nothing when the directory has
no store or the store's contract has no dashboard view.
"""

from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from artifact_store import DASHBOARD_VIEW, binary, resolve  # noqa: E402

NEEDS_YOU = frozenset({"Blocking Question", "Open Question", "Needs Human", "Unsigned Manual Check"})


def target_directory(argv: list[str]) -> Path | None:
    if argv:
        return Path(argv[0])
    raw = "" if sys.stdin.isatty() else sys.stdin.read()
    if not raw.strip():
        return Path.cwd()
    try:
        status = json.loads(raw)
    except ValueError:
        return None
    if not isinstance(status, dict):
        return None
    workspace = status.get("workspace")
    directory = (workspace.get("current_dir") if isinstance(workspace, dict) else None) or status.get("cwd")
    return Path(directory) if isinstance(directory, str) and directory else None


def summarize(markdown: str) -> list[str]:
    efforts: dict[str, dict[str, int]] = {}
    counts: dict[str, int] | None = None
    section = None
    for line in markdown.splitlines():
        if line.startswith("## "):
            counts = efforts.setdefault(line[3:].strip(), {"goal": 0, "running": 0, "ready": 0, "needs you": 0})
            section = None
        elif line.startswith("### "):
            section = line[4:].strip()
        elif line.startswith("- ") and counts is not None:
            if section == "Goal":
                counts["goal"] += 1
            elif section == "Running":
                counts["running"] += 1
            elif section == "Ready":
                counts["ready"] += 1
            elif section in NEEDS_YOU:
                counts["needs you"] += 1
    lines = []
    for effort, counts in efforts.items():
        parts = [f"{counts[key]} {key}" for key in ("running", "ready", "needs you") if counts[key]]
        if counts["goal"] or parts:
            lines.append(" · ".join([effort, *parts]))
    return lines


def main(argv: list[str]) -> int:
    directory = target_directory(argv)
    if directory is None or not directory.is_dir():
        return 0
    target = resolve(directory)
    if target.store is None or not target.has_view(DASHBOARD_VIEW):
        return 0
    try:
        result = subprocess.run(
            [binary(), *target.cli_args(), "view", "--id", DASHBOARD_VIEW],
            capture_output=True, text=True, timeout=2, cwd=str(target.root),
        )
    except (OSError, subprocess.TimeoutExpired):
        return 0
    if result.returncode == 0:
        for line in summarize(result.stdout):
            print(line)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
